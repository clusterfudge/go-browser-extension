{
  "manifest_version": 2,
  "browser_action": {
    "default_icon": "icon@48.png",
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "*://go/*",
    "*://*.trot.to/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "trotto-extension-staging@trot.to"
    }
  }
}
